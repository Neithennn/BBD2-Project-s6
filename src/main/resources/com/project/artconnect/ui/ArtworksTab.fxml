<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.ArtworkController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <SplitPane dividerPositions="0.66" VBox.vgrow="ALWAYS">
        <TableView fx:id="artworkTable">
            <columns>
                <TableColumn fx:id="titleColumn" text="Title" prefWidth="170" />
                <TableColumn fx:id="artistColumn" text="Artist" prefWidth="140" />
                <TableColumn fx:id="typeColumn" text="Type" prefWidth="100" />
                <TableColumn fx:id="yearColumn" text="Year" prefWidth="70" />
                <TableColumn fx:id="mediumColumn" text="Medium" prefWidth="130" />
                <TableColumn fx:id="dimensionsColumn" text="Dimensions" prefWidth="110" />
                <TableColumn fx:id="priceColumn" text="Price" prefWidth="80" />
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="100" />
            </columns>
        </TableView>
        <VBox spacing="8.0" prefWidth="360.0">
            <Label text="Artwork details" style="-fx-font-size: 16; -fx-font-weight: bold;" />
            <GridPane hgap="8.0" vgap="8.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="95.0" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>
                <Label text="Title" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="titleField" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                <Label text="Artist" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <ComboBox fx:id="artistInput" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                <Label text="Status" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <ComboBox fx:id="statusInput" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                <Label text="Year" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <TextField fx:id="creationYearField" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                <Label text="Type" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                <TextField fx:id="typeField" GridPane.rowIndex="4" GridPane.columnIndex="1" />
                <Label text="Medium" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                <TextField fx:id="mediumField" GridPane.rowIndex="5" GridPane.columnIndex="1" />
                <Label text="Dimensions" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                <TextField fx:id="dimensionsField" GridPane.rowIndex="6" GridPane.columnIndex="1" />
                <Label text="Price" GridPane.rowIndex="7" GridPane.columnIndex="0" />
                <TextField fx:id="priceField" GridPane.rowIndex="7" GridPane.columnIndex="1" />
            </GridPane>
            <Label text="Description" />
            <TextArea fx:id="descriptionField" prefRowCount="5" wrapText="true" VBox.vgrow="ALWAYS" />
            <HBox spacing="8.0">
                <Button text="Create" onAction="#handleCreate" />
                <Button text="Update" onAction="#handleUpdate" />
                <Button text="Delete" onAction="#handleDelete" />
                <Button text="Clear" onAction="#handleClearForm" />
            </HBox>
        </VBox>
    </SplitPane>
</VBox>
