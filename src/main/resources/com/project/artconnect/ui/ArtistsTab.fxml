<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.ArtistController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search artists..." HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="disciplineFilter" promptText="Filter by Discipline" />
        <Button text="Search" onAction="#handleSearch" />
        <Button text="Reset" onAction="#handleReset" />
    </HBox>
    <SplitPane dividerPositions="0.66" VBox.vgrow="ALWAYS">
        <TableView fx:id="artistTable">
            <columns>
                <TableColumn fx:id="nameColumn" text="Name" prefWidth="170" />
                <TableColumn fx:id="cityColumn" text="City" prefWidth="120" />
                <TableColumn fx:id="emailColumn" text="Email" prefWidth="190" />
                <TableColumn fx:id="yearColumn" text="Birth Year" prefWidth="90" />
                <TableColumn fx:id="disciplinesColumn" text="Disciplines" prefWidth="190" />
                <TableColumn fx:id="activeColumn" text="Status" prefWidth="80" />
            </columns>
        </TableView>
        <VBox spacing="8.0" prefWidth="360.0">
            <Label text="Artist details" style="-fx-font-size: 16; -fx-font-weight: bold;" />
            <GridPane hgap="8.0" vgap="8.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="90.0" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>
                <Label text="Name" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                <Label text="Birth year" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <TextField fx:id="birthYearField" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                <Label text="Email" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <TextField fx:id="emailField" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                <Label text="Phone" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <TextField fx:id="phoneField" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                <Label text="City" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                <TextField fx:id="cityField" GridPane.rowIndex="4" GridPane.columnIndex="1" />
                <Label text="Website" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                <TextField fx:id="websiteField" GridPane.rowIndex="5" GridPane.columnIndex="1" />
                <Label text="Social" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                <TextField fx:id="socialMediaField" GridPane.rowIndex="6" GridPane.columnIndex="1" />
                <Label text="Disciplines" GridPane.rowIndex="7" GridPane.columnIndex="0" />
                <TextField fx:id="disciplinesField" promptText="Peinture, Sculpture" GridPane.rowIndex="7" GridPane.columnIndex="1" />
                <Label text="Active" GridPane.rowIndex="8" GridPane.columnIndex="0" />
                <CheckBox fx:id="activeCheckBox" GridPane.rowIndex="8" GridPane.columnIndex="1" />
            </GridPane>
            <Label text="Bio" />
            <TextArea fx:id="bioField" prefRowCount="4" wrapText="true" VBox.vgrow="ALWAYS" />
            <HBox spacing="8.0">
                <Button text="Create" onAction="#handleCreate" />
                <Button text="Update" onAction="#handleUpdate" />
                <Button text="Delete" onAction="#handleDelete" />
                <Button text="Clear" onAction="#handleClearForm" />
            </HBox>
        </VBox>
    </SplitPane>
</VBox>
