<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.ExhibitionController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <SplitPane dividerPositions="0.66" VBox.vgrow="ALWAYS">
        <TableView fx:id="exhibitionTable">
            <columns>
                <TableColumn fx:id="titleColumn" text="Title" prefWidth="180" />
                <TableColumn fx:id="galleryColumn" text="Gallery" prefWidth="150" />
                <TableColumn fx:id="dateColumn" text="Start Date" prefWidth="110" />
                <TableColumn fx:id="endDateColumn" text="End Date" prefWidth="110" />
                <TableColumn fx:id="themeColumn" text="Theme" prefWidth="150" />
                <TableColumn fx:id="curatorColumn" text="Curator" prefWidth="140" />
            </columns>
        </TableView>
        <VBox spacing="8.0" prefWidth="360.0">
            <Label text="Exhibition details" style="-fx-font-size: 16; -fx-font-weight: bold;" />
            <GridPane hgap="8.0" vgap="8.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="95.0" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>
                <Label text="Title" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="titleField" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                <Label text="Gallery" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <ComboBox fx:id="galleryInput" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                <Label text="Start" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <DatePicker fx:id="startDateInput" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                <Label text="End" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <DatePicker fx:id="endDateInput" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                <Label text="Theme" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                <TextField fx:id="themeField" GridPane.rowIndex="4" GridPane.columnIndex="1" />
                <Label text="Curator" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                <TextField fx:id="curatorField" GridPane.rowIndex="5" GridPane.columnIndex="1" />
            </GridPane>
            <Label text="Description" />
            <TextArea fx:id="descriptionField" prefRowCount="6" wrapText="true" VBox.vgrow="ALWAYS" />
            <HBox spacing="8.0">
                <Button text="Create" onAction="#handleCreate" />
                <Button text="Update" onAction="#handleUpdate" />
                <Button text="Delete" onAction="#handleDelete" />
                <Button text="Clear" onAction="#handleClearForm" />
            </HBox>
        </VBox>
    </SplitPane>
</VBox>
