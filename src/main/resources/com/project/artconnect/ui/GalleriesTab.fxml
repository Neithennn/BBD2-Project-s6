<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.GalleryController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <TableView fx:id="galleryTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="180" />
            <TableColumn fx:id="addressColumn" text="Address" prefWidth="230" />
            <TableColumn fx:id="ownerColumn" text="Owner" prefWidth="150" />
            <TableColumn fx:id="hoursColumn" text="Opening hours" prefWidth="140" />
            <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="120" />
            <TableColumn fx:id="ratingColumn" text="Rating" prefWidth="80" />
            <TableColumn fx:id="websiteColumn" text="Website" prefWidth="190" />
            <TableColumn fx:id="exhibitionsColumn" text="Exhibitions" prefWidth="90" />
        </columns>
    </TableView>
</VBox>
